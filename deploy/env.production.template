# ═══════════════════════════════════════════════════════
# PRODUCTION .env  —  Hostinger
# ═══════════════════════════════════════════════════════
# Server par project root me `.env` bana kar ye copy karo, phir values bharo.
# Ye file sirf template hai — isme kabhi asli secret mat likhna (git me jaati hai).
#
# GitHub ki ZIP me `.env` NAHI aati (wo gitignored hai) — isliye ye file har
# baar server par khud banani padti hai.

# ── Database ──────────────────────────────────────────
# mysql    -> Hostinger ka MySQL (Business/Cloud ya VPS, dono par milta hai)
# postgres -> sirf VPS par possible hai
DB_KIND=mysql

# Hostinger hPanel -> Databases -> MySQL Databases se ye chaar milte hain.
# DATABASE_URL KHAALI hi rehne do jab DB_* bhare hon.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=            # hPanel jaisa dikhaye waisa hi — usme prefix hota hai (u123456789_xxx)
DB_PASSWORD=
DB_NAME=            # ye bhi prefixed hota hai (u123456789_taskmanager)

# ⚠️  DB_USER / DB_NAME me Hostinger ka prefix zaroor rakhna. Panel me aap
#     "taskmanager" likhte ho par asli naam "u123456789_taskmanager" banta hai —
#     bina prefix ke "Access denied" milta hai aur wajah kahin nahi dikhti.

NODE_ENV=production
PORT=3000
# Hostinger ke Node.js app par port panel khud deta hai. Wahan is line ko
# hata dena — app process.env.PORT le legi (server.js:50).

# ⚠️  KHAALI MAT CHHODNA.
# Khaali hone par server.js:32 chup-chaap 'change-me' use karega — phir koi bhi
# admin ka JWT khud bana kar poori app me ghus sakta hai. Naya generate karo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local wala secret yahan mat daalna.
SESSION_SECRET=

# https:// hi rakhna — emails aur WhatsApp me yahi link jaata hai
APP_URL=https://tasks.balajijewels.com

# Pehla admin. seed-admin.js in dono ko padhta hai.
# ⚠️  Local/dev wala password yahan mat daalna — naya strong password rakho.
ADMIN_EMAIL=Admin@balajijewels.com
ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────
# Ye khaali rahe to app chalti hai, bas wo feature band rehta hai
# (boot par warning aayegi, crash nahi hoga).

# VPS par schedulers khud chalte hain (IS_SERVERLESS false hota hai), isliye
# CRON_SECRET ki zarurat nahi. Details ke liye DEPLOY.md padho.
CRON_SECRET=

# Email reminders (khaali = reminder scheduler band)
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Balaji Jewels

# Proof video upload -> Google Drive (khaali = video upload band)
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_SECRET=
GDRIVE_VIDEO_FOLDER_ID=

# WhatsApp (khaali = WhatsApp scheduler band)
WAUMFY_API_KEY=
WAUMFY_TRIGGER_URL=
WAUMFY_DOC_TRIGGER_URL=
WAUMFY_IMAGE_TRIGGER_URL=
WA_SCHEDULER_ENABLED=true

# ── VPS + PostgreSQL wala option ──────────────────────
# Agar VPS le rahe ho aur Postgres chahiye, upar ki jagah ye:
#   DB_KIND=postgres
#   DB_PORT=5432
#   DATABASE_URL=            <- khaali hi rakhna!
# ⚠️  Yahan DATABASE_URL me postgresql://...@localhost/... likha to
#     db-postgres.js:135 SSL force kar dega aur local Postgres (SSL off)
#     connect nahi hoga. Majboori ho to PGSSL_DISABLE=true bhi daalo.
